<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Labyrinthe.Connect.AspNetCore</RootNamespace>
    <PackageId>Labyrinthe.Connect.AspNetCore</PackageId>
    <Title>Labyrinthe Connect for ASP.NET Core</Title>
    <Description>ASP.NET Core integration of the Labyrinthe Connect SDK: services.AddLabyrinthe(configuration) with IHttpClientFactory and Microsoft.Extensions.Logging, and a minimal API endpoint that verifies signed webhooks (app.MapLabyrintheWebhooks).</Description>
    <PackageTags>$(PackageTags);aspnetcore;webhooks;dependency-injection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Labyrinthe.Connect\Labyrinthe.Connect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Labyrinthe.Connect.Tests" />
  </ItemGroup>

</Project>
