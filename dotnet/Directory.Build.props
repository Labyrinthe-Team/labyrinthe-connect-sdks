<Project>
  <!-- Réglages communs à tous les projets du SDK .NET (bibliothèques, tests, exemples). -->
  <PropertyGroup>
    <!-- Version du package : à garder égale à LabyrintheClient.Version (vérifié par les tests et la publication). -->
    <Version>1.2.0</Version>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>

    <Authors>Labyrinthe Connect</Authors>
    <Company>Labyrinthe RDC</Company>
    <Copyright>Copyright (c) 2026 Labyrinthe Connect</Copyright>
    <PackageProjectUrl>https://github.com/Labyrinthe-Team/labyrinthe-connect-sdks/tree/main/dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Labyrinthe-Team/labyrinthe-connect-sdks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>https://github.com/Labyrinthe-Team/labyrinthe-connect-sdks/blob/main/dotnet/CHANGELOG.md</PackageReleaseNotes>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Tests et exemples : fichier de documentation généré pour que le SDK .NET 10 applique IDE0005
       (usings inutiles) au build, sans exiger de commentaires XML (CS1591). src/* garde CS1591. -->
  <PropertyGroup Condition="!$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\', '/').Contains('/src/'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Builds reproductibles et SourceLink en CI (GitHub Actions). Hors dépôt git, SourceLink est désactivé. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' != 'true'">
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>
</Project>
