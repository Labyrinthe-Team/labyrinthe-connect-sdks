{
  "name": "@labyrinthe/connect-openapi",
  "version": "1.0.0",
  "private": true,
  "description": "Spécification OpenAPI de l'API développeurs Labyrinthe Connect (source de vérité des SDK).",
  "type": "module",
  "scripts": {
    "lint": "redocly lint openapi.yaml",
    "check:routes": "node scripts/check-routes.mjs",
    "test:contract": "node scripts/contract.mjs",
    "sync": "node scripts/sync.mjs",
    "docs": "redocly build-docs openapi.yaml -o dist/index.html"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.5",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "yaml": "2.8.1"
  }
}
