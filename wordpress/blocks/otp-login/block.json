{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "labyrinthe-connect/otp-login",
	"version": "1.2.0",
	"title": "SMS login (Labyrinthe Connect)",
	"category": "widgets",
	"icon": "smartphone",
