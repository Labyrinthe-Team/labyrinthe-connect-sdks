	"attributes": {
		"redirect": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"multiple": false
	},
	"editorScript": "file:./index.js"
}
