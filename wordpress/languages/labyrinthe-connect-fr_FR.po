msgstr "Labyrinthe Connect : votre compte est suspendu."

#. translators: %s: request ID (X-Request-Id), to give to the support.
#: includes/admin/class-admin.php:223
#, php-format
msgid "The platform has closed the API for this account: no SMS and no OTP code can be sent until it is reactivated. Contact the Labyrinthe Connect support (connect@labyrinthe-rdc.com) and give the request ID %s."
msgstr "La plateforme a fermé l’API pour ce compte : aucun SMS ni code OTP ne peut être envoyé jusqu’à sa réactivation. Contactez le support de Labyrinthe Connect (connect@labyrinthe-rdc.com) en indiquant l’identifiant de requête %s."

