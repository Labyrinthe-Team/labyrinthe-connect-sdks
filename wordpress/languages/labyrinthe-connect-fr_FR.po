#, php-format
msgid "%1$d characters, Unicode (UCS-2), %2$d SMS segment(s), even without accents: emoji or non-Latin characters make each SMS hold 70 characters instead of 160."
msgstr "%1$d caractères, Unicode (UCS-2), %2$d segment(s) SMS, même sans accents : des emoji ou des caractères non latins limitent chaque SMS à 70 caractères au lieu de 160."

#: includes/admin/class-admin.php:185
